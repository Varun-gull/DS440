# Required for authentication and application data.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Required only for the server-side posting-cache sync.
# Never expose this value in browser code or commit a real key.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Recommended in production to protect /api/postings/sync.
CRON_SECRET="replace-with-a-long-random-value"

# Used by scripts/sync-postings.mjs outside local development.
CAREERUP_BASE_URL="http://localhost:3000"

# Used only by scripts/verify-profile-messages.mjs.
CAREERUP_TEST_SENDER_EMAIL=""
CAREERUP_TEST_SENDER_PASSWORD=""
CAREERUP_TEST_RECIPIENT_EMAIL=""
CAREERUP_TEST_RECIPIENT_PASSWORD=""
