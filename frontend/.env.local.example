NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server only. Never use NEXT_PUBLIC_ for these settings.
SUPABASE_SERVICE_ROLE_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Exact site origin, no trailing path. Change for production.
EMAIL_SCANNER_BASE_URL="http://localhost:3000"
# Generate a fresh 32 byte base64 key. Keep it outside Git and never share it.
# Rotating this key requires disconnecting and reconnecting stored mailboxes.
EMAIL_SCANNER_ENCRYPTION_KEY=""

# Career assistant. Permanent provider keys are server only.
GEMINI_API_KEY=""
CAREERUP_CHAT_MODEL="gemini-3.5-flash-lite"
CAREERUP_VOICE_MODEL="gemini-3.8-live"
CAREERUP_VOICE_ENABLED="false"
# Exact production origin; used for assistant request validation.
APP_BASE_URL="http://localhost:3000"
